# ==== rss-letter 环境变量示例 ====
# 复制为 .env 后按需修改；.env 含 SMTP 准据，绝不提交进仓库

# ---- 服务 ----
PORT=3000
HOST=0.0.0.0
# SQLite 数据库文件路径（Docker 内固定为 /app/data/rss-letter.sqlite）
RSS_LETTER_DB=./data/rss-letter.sqlite

# RSS 源列表：逗号分隔，可填任意多个
RSS_SOURCES=https://example.org/rss.xml,https://example.com/feed

# 管理令牌：POST /api/digest/run 与 GET /api/subscribers/count 需要（务必改成随机长串）
RSS_LETTER_ADMIN_TOKEN=change-me-to-a-long-random-string

# 摘要窗口：聚合过去多少天的条目；单封最多带多少条
DIGEST_DAYS=7
DIGEST_MAX_ITEMS=20

# ---- 展示 ----
# 站点/服务名（邮件署名与标题用）
SITE_NAME=rss-letter
# 面向订阅者的主页
SITE_URL=http://localhost:3000
# 本服务对外可达的基础地址（确认/退订链接用）；未填则回退 SITE_URL
# 例：https://mail.example.org
API_URL=

# 默认页面语言：zh / en
DEFAULT_LANG=zh

# 模板覆盖目录（templates/confirm.zh.html 等）
TEMPLATES_DIR=./templates

# ---- SMTP（不配置则订阅接口返回 503，摘要无法发送）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SENDER_NAME=rss-letter
# 发件人地址，例：noreply@example.org
SENDER_EMAIL=
