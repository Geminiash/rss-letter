{
  "name": "rss-letter",
  "version": "0.1.0",
  "description": "Self-hosted service that turns any RSS feeds into a weekly digest email / 自托管服务：把任意 RSS 源变成每周一封摘要邮件",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "digest": "tsx src/digest.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.9.6",
    "nodemailer": "^7.0.6",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geminiash/rss-letter.git"
  },
  "bugs": {
    "url": "https://github.com/Geminiash/rss-letter/issues"
  },
  "homepage": "https://github.com/Geminiash/rss-letter#readme"
}
